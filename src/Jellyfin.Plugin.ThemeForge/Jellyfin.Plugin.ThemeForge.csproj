<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.ThemeForge</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ThemeForge</RootNamespace>
    <Version>$(ThemeForgeVersion)</Version>
    <AssemblyVersion>$(ThemeForgeVersion)</AssemblyVersion>
    <FileVersion>$(ThemeForgeVersion)</FileVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin host at runtime; referenced for compilation only. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\**\*.html" />
    <EmbeddedResource Include="Web\**\*.js" />
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.ThemeForge.Tests" />
  </ItemGroup>

  <!--
    Jellyfin loads the plugin into a process that already provides the framework and
    host assemblies. Shipping our own copies causes assembly-identity conflicts, so
    everything the host supplies is removed from the plugin output.
  -->
  <Target Name="RemoveHostProvidedAssemblies" AfterTargets="Build">
    <ItemGroup>
      <HostProvided Include="$(OutputPath)Jellyfin.Controller.dll" />
      <HostProvided Include="$(OutputPath)Jellyfin.Model.dll" />
      <HostProvided Include="$(OutputPath)Jellyfin.Data.dll" />
      <HostProvided Include="$(OutputPath)Jellyfin.Extensions.dll" />
      <HostProvided Include="$(OutputPath)Jellyfin.Networking.dll" />
      <HostProvided Include="$(OutputPath)Jellyfin.MediaEncoding.dll" />
      <HostProvided Include="$(OutputPath)MediaBrowser.*.dll" />
      <HostProvided Include="$(OutputPath)Emby.*.dll" />
      <HostProvided Include="$(OutputPath)System.*.dll" />
      <HostProvided Include="$(OutputPath)Microsoft.*.dll" />
      <HostProvided Include="$(OutputPath)Newtonsoft.Json.dll" />
      <HostProvided Include="$(OutputPath)ICU4N*.dll" />
      <HostProvided Include="$(OutputPath)J2N.dll" />
      <HostProvided Include="$(OutputPath)Diacritics.dll" />
      <HostProvided Include="$(OutputPath)*.pdb" />
      <HostProvided Include="$(OutputPath)*.xml" />
      <HostProvided Include="$(OutputPath)*.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(HostProvided)" />
  </Target>

</Project>
