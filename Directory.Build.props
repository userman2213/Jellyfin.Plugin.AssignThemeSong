<Project>

  <PropertyGroup>
    <!--
      Jellyfin 12 and later, which run on .NET 10. Up to 2.11 a second build targeted Jellyfin
      10.11 on .NET 9; those packages stay in the catalogue for servers still on 10.11, but
      nothing newer is built for it.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Pinned: under the .NET 10 SDK "latest" would mean C# 14, and the code was written and
         tested as C# 13. -->
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Jellyfin pins its own versions of several transitive packages; a downgrade
         warning here is expected and must not fail the build. -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>

    <ThemeForgeVersion>3.0.0.0</ThemeForgeVersion>

    <!-- The plugin SDK the build compiles against, and the Jellyfin ABI the package declares. -->
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <ThemeForgeTargetAbi>12.0.0.0</ThemeForgeTargetAbi>
  </PropertyGroup>

</Project>
