<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Jellyfin pins its own versions of several transitive packages; a downgrade
         warning here is expected and must not fail the build. -->
    <MSBuildWarningAsErrors>$(MSBuildWarningAsErrors.Replace(';NU1605', ''))</MSBuildWarningAsErrors>
    <NoWarn>$(NoWarn);NU1605</NoWarn>

    <ThemeForgeVersion>2.0.0.0</ThemeForgeVersion>
  </PropertyGroup>

</Project>
